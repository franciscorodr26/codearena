{
  "id": "echo-detector",
  "title": "Echo Detector",
  "difficulty": "hard",
  "tags": [
    "strings",
    "hashing",
    "binary search"
  ],
  "description": "A replay log is one long string of move letters. An *echo* is a block of moves that appears at least twice in the log; the two copies may overlap.\n\nReturn the length of the longest echo, or `0` if no block appears twice. The largest test is 1,500 moves long.",
  "function": {
    "name": "longestEcho",
    "pythonName": "longest_echo",
    "params": [
      {
        "name": "log",
        "type": "string"
      }
    ],
    "returns": "integer"
  },
  "compare": {
    "mode": "exact"
  },
  "examples": [
    {"args": ["UDLRUDLX"], "expected": 3},
    {"args": ["UDLR"], "expected": 0},
    {"args": ["UUUU"], "expected": 3}
  ],
  "tests": [
    {"args": [""], "expected": 0},
    {"args": ["U"], "expected": 0},
    {"args": ["ABAB"], "expected": 2},
    {"args": ["ABCDEFG"], "expected": 0},
    {"args": ["ULDDLRRLDLDLLDRLUUUDDLURURLURLRDRRDLDDRULDLDLLDRLUUUD"], "expected": 13},
    {"args": [""], "expected": 87},
    {"args": [""], "expected": 255}
  ]
}
