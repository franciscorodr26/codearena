{
  "id": "replay-compress",
  "title": "Replay Compress",
  "difficulty": "easy",
  "tags": [
    "strings",
    "run length"
  ],
  "description": "A replay records one move per tick as a letter: `U`, `D`, `L` or `R`. To save space, each run of the same move is stored as the letter followed by how many times it repeats, so `UUUDL` becomes `U3D1L1`.\n\nReturn the compressed form of `moves`. An empty replay compresses to an empty string.",
  "function": {
    "name": "compressReplay",
    "pythonName": "compress_replay",
    "params": [
      {
        "name": "moves",
        "type": "string"
      }
    ],
    "returns": "string"
  },
  "compare": {
    "mode": "exact"
  },
  "examples": [
    {"args": ["UUUDL"], "expected": "U3D1L1"},
    {"args": ["RRRRRRRRRRRR"], "expected": "R12"}
  ],
  "tests": [
    {"args": [""], "expected": ""},
    {"args": ["U"], "expected": "U1"},
    {"args": ["UD"], "expected": "U1D1"},
    {"args": ["LLLRRRLLL"], "expected": "L3R3L3"},
    {"args": ["DUURLLDLUDUUUDUDURDDURRDUDLLRLRUUDLURDRU"], "expected": "D1U2R1L2D1L1U1D1U3D1U1D1U1R1D2U1R2D1U1D1L2R1L1R1U2D1L1U1R1D1R1U1"},
    {"args": [""], "expected": ""}
  ]
}
