          ".#.#.#..#.#####.#.#...#.#.####..###.#..#",
          "...#..#..#.....#...####.##..####.#...##.",
          "...#.##.##....##.###...#.#.####..#.#..##",
          "#.....##.###.##.#.#..##.#.#.#..####..#..",
          "##..#.########...########.###.#..#..#...",
          ".#.#.#.#.####...#..###...##..####....###",
          "####.#..#..##..#...####..####...#.###..#",
          "..#...#.#...#.#.##..........##..#...##.#",
          "##.#.###..#.##..###.####.##.#..#.###.###",
          ".##....#...#.###..#...#..######.#..#.#.#",
          "##..##.###.##.##.#..##..#.#..##.##..##..",
