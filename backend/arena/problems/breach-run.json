{
  "id": "breach-run",
  "title": "Breach Run",
  "difficulty": "hard",
  "tags": [
    "graphs",
    "bfs"
  ],
  "description": "The arena is a grid of strings where `.` is open floor and `#` is a wall. You start in the top-left cell and must reach the bottom-right cell (both are always open), moving one cell up, down, left or right per step.\n\nYou carry `charges` breaching charges. Moving into a wall cell uses one charge. Return the fewest steps needed to reach the exit, or `-1` if it cannot be reached.",
  "function": {
    "name": "breachRun",
    "pythonName": "breach_run",
    "params": [
      {
        "name": "grid",
        "type": "string[]"
      },
      {
        "name": "charges",
        "type": "integer"
      }
    ],
    "returns": "integer"
  },
  "compare": {
    "mode": "exact"
  },
  "examples": [
    {
      "args": [
        [
          "..#",
          "##.",
          "..."
        ],
        0
      ],
      "expected": -1
    },
    {
      "args": [
        [
          ".##",
          "###",
          "##."
        ],
        1
      ],
      "expected": -1
    }
  ],
  "tests": [
    {
      "args": [
        [
          "."
        ],
        0
      ],
      "expected": 0
    },
    {
      "args": [
        [
          ".#",
          "#."
        ],
        0
      ],
      "expected": -1
    },
    {
      "args": [
        [
          ".#",
          "#."
        ],
        1
      ],
      "expected": 2
    },
    {
      "args": [
        [
          ".#....",
          "#.....",
          "#.#.##",
          "#...##",
          "####..",
          "..#..."
        ],
        0
      ],
      "expected": -1
    },
    {
      "args": [
        [
          "...###",
          "#..#.#",
          "#..##.",
          ".#.##.",
          "#.#.##",
          ".#...."
        ],
        2
      ],
      "expected": 10
    },
    {
      "args": [
        [
          "..##..#....##..#...##..#.",
          "...#.#...#....#####.#..##",
          "#.#....##.###.#..#..#....",
          "..#.##....##..####...#..#",
          ".#..##.........#.#.#.....",
          ".##.......###..#...###...",
          "......#.#........#######.",
          ".#.#......#..##.####.....",
          "#..#.....#....#...#..###.",
          "..##.........##..#.##.##.",
          ".###....#..##..#....#...#",
          "..#.#....#..#.#...##.#..#",
          "..#.#...#...#......#..#.#",
          "#..###.#...##....##....##",
          "#..........##...#.#...#..",
          "#..#.#...#.###..#.....##.",
          ".#..####.....#.......#..#",
          "...#......##..##.#....#.#",
          ".##.....#.......#.#####..",
          ".##.....#...#...##...#..."
        ],
        1
      ],
      "expected": 49
    },
    {
      "args": [
        [
          ".#######.###..##....#..##..#####.#.#....",
          "#.#.#....####....#.#...##.#..##..#..###.",
          "..##.#.##....##...##..#.#####...#.##.#..",
          "##.##.##.#..##..#...#.##....#####.#####.",
