          ".##..##.#..#######.####.##.##..#####.#.#",
          "#..###.###..######.#########.#.#.#######",
          "####.###.#.###.#.####....#...#######.##.",
          "##.#..#####..#####..######.#.#.######..#",
          ".###..##.#...######..##.##...##..###.#.#",
          ".###.#.####..#.##.###.##..####..##.#####",
