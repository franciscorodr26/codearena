{
  "id": "team-split",
  "title": "Team Split",
  "difficulty": "hard",
  "tags": [
    "dynamic programming",
    "subset sum"
  ],
  "description": "Split all players into two teams (a team may be empty) so that the total ratings of the two teams are as close as possible. Every player must be on exactly one team.\n\nReturn the smallest possible difference between the two team totals. There are at most 40 players and every rating is between 0 and 3000.",
  "function": {
    "name": "minTeamGap",
    "pythonName": "min_team_gap",
    "params": [
      {
        "name": "ratings",
        "type": "integer[]"
      }
    ],
    "returns": "integer"
  },
  "compare": {
    "mode": "exact"
  },
  "examples": [
    {
      "args": [
        [
          1500,
          1200,
          1300,
          1400
        ]
      ],
      "expected": 0
    },
    {
      "args": [
        [
          2000,
          900,
          800
        ]
      ],
      "expected": 300
    }
  ],
