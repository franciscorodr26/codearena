    "name": "finalHealth",
    "pythonName": "final_health",
    "params": [
      {
        "name": "start",
        "type": "integer"
      },
      {
        "name": "max",
        "type": "integer"
      },
      {
        "name": "events",
        "type": "integer[]"
      }
    ],
    "returns": "integer"
  },
  "compare": {
    "mode": "exact"
  },
