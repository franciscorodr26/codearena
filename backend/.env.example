# Backend Environment Variables
# Copy this to .env and fill in values as needed

# Server
PORT=3001
NODE_ENV=development
# Required only for legacy /admin maintenance endpoints. Generate a strong,
# random value (for example: openssl rand -hex 32). Unset means deny all.
ADMIN_KEY=

# Database (SQLite - auto-created)
DB_PATH=./data.sqlite

# JWT Secret (required for auth - generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Public origins for this deployment.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# Comma-separated browser origins. Production rejects localhost origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: comma-separated host fragments that production URLs must never
# contain (guards against pointing a deployment at the wrong product).
# CODEARENA_FORBIDDEN_HOST_FRAGMENTS=

# ============================================
# OPTIONAL - Only needed for specific features
# ============================================

# Code execution (required for battles and practice). Pick one:
#   JUDGE0_URL        a Judge0 server you run (see docker-compose.judge0.yml)
#   RAPIDAPI_KEY      Judge0 CE on RapidAPI
#   CODEARENA_RUNNER  "local" runs code on this machine with NO sandbox: development only
JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=
# RAPIDAPI_KEY=
# CODEARENA_RUNNER=local

# Extra problems kept out of git, laid out like backend/arena (problems/, solutions/).
# CODEARENA_PRIVATE_PROBLEMS_DIR=/srv/codearena-private

# Email (required for verification, account recovery, and notifications)
RESEND_API_KEY=
EMAIL_FROM="CodeArena <noreply@codearena.co>"
SUPPORT_EMAIL=support@codearena.co
# CAN-SPAM physical mailing address. Required by law in any commercial email footer.
COMPANY_ADDRESS=Your organisation, street address, city

# Stripe (optional; required for CreatorArena credit purchases and for existing
# legacy subscribers to manage or cancel their old subscription)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth (required for Google Sign-In)
GOOGLE_CLIENT_ID=

# GitHub OAuth (required for GitHub Sign-In)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Legacy compatibility alias. Prefer BACKEND_URL for new deployments.
API_URL=http://localhost:3001

# AI-backed features: CreatorArena, prompt battles and prompt practice, complexity feedback.
# Leave unset to run without them; the UI says the feature is not enabled.
ANTHROPIC_API_KEY=

# More prompt battle models. Each appears in the model picker only when its key
# is set; Claude Haiku, Sonnet and Opus come with ANTHROPIC_API_KEY. Pricier
# models count more against CODEARENA_GLOBAL_DAILY_PROMPT_EVALUATION_LIMIT.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_LABEL=GPT-4o mini
# OPENAI_PREMIUM_MODEL=            # OpenAI's frontier model, e.g. a GPT "Sol" model id
# OPENAI_PREMIUM_MODEL_LABEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_LABEL=Gemini 2.5 Flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL_LABEL=DeepSeek
# Prompt battle live preview (set to false to disable in-match model output previews)
PROMPT_BATTLE_PREVIEW_ENABLED=true

# Agent battles (AI agents you configure race each other on a problem).
# They call the model API on every battle, so they are off unless you set both
# CODEARENA_AGENT_BATTLES=1 and ANTHROPIC_API_KEY. Per-user spending and rate
# limits apply (services/agentSpendingLimiter.js, services/agentRateLimiter.js).
# CODEARENA_AGENT_BATTLES=1

# CodeArena free-consumer fair-use limits (UTC day; positive integers only)
CODEARENA_DAILY_PRACTICE_EXECUTION_LIMIT=25
CODEARENA_DAILY_BATTLE_CODE_EXECUTION_LIMIT=50
CODEARENA_DAILY_BOT_BATTLE_LIMIT=20
CODEARENA_BOT_BATTLE_REQUESTS_PER_MINUTE=6
CODEARENA_BOT_BATTLE_STARTS_PER_MINUTE=6
CODEARENA_MAX_ACTIVE_BOT_BATTLES_PER_USER=1
CODEARENA_MAX_ACTIVE_BOT_BATTLES=500
CODEARENA_BOT_BATTLE_MAX_LIFETIME_MINUTES=20
# In-memory human/private battle safeguards
CODEARENA_MAX_IN_MEMORY_BATTLES=2000
CODEARENA_MAX_ACTIVE_PRIVATE_BATTLES_PER_USER=2
# Prompt-battle room safeguards (durations are milliseconds)
CODEARENA_MAX_PROMPT_BATTLE_ROOMS=2000
CODEARENA_PROMPT_ROOM_CREATE_LIMIT_PER_MINUTE=5
CODEARENA_PROMPT_LOBBY_TTL_MS=900000
CODEARENA_PROMPT_DONE_ROOM_TTL_MS=600000
CODEARENA_MAX_PROMPT_ROOM_RATE_BUCKETS=10000
CODEARENA_DAILY_PROMPT_PRACTICE_LIMIT=3
CODEARENA_DAILY_CHALLENGE_PROMPT_LIMIT=3
CODEARENA_DAILY_PROMPT_BATTLE_MODEL_LIMIT=10
CODEARENA_DAILY_COMPLEXITY_ANALYSIS_LIMIT=5
CODEARENA_DAILY_CREATOR_VERIFICATION_LIMIT=5
# Global cost circuit breakers shared by all users on this server instance.
CODEARENA_GLOBAL_DAILY_CODE_EXECUTION_LIMIT=5000
CODEARENA_GLOBAL_DAILY_PROMPT_EVALUATION_LIMIT=500
CODEARENA_GLOBAL_DAILY_CREATOR_VERIFICATION_LIMIT=100

# CreatorArena generation tuning (optional)
# Primary model for full generations
CREATORARENA_MODEL=claude-sonnet-4-6
# Cost-controlled model for revise/fix and repair requests
CREATORARENA_REVISION_MODEL=claude-haiku-4-5-20251001
# Bounded output budgets keep one credit purchase economically predictable
CREATORARENA_MAX_TOKENS=7000
CREATORARENA_REVISION_MAX_TOKENS=3000
CREATORARENA_REPAIR_MAX_TOKENS=2500
# Skip AI moderation pass for revise/fix (keeps word/profanity checks)
CREATORARENA_SKIP_MODERATION_FOR_REVISIONS=true
# Truncate very large existing HTML context in revise/fix requests for speed
CREATORARENA_REVISION_HTML_CONTEXT_LIMIT=40000
# CreatorArena verification tuning
CREATORARENA_VERIFY_TIMEOUT_MS=8000
CREATORARENA_VERIFY_ACCURACY_THRESHOLD=0.66
CREATORARENA_VERIFY_ACCURACY_MODEL=claude-haiku-4-5-20251001

# Push Notifications (optional — leave unset for local dev; placeholder keys crash web-push validation)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Analytics
MIXPANEL_TOKEN=

# Sentry Error Tracking
SENTRY_DSN=

# Image Moderation (Sightengine - optional, photos allowed without it)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Cloud Storage (Cloudinary - required for production avatar uploads)
# Without Cloudinary, avatars use local storage, which does not persist on ephemeral hosts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local-only: when set to 1 and NODE_ENV is not production, POST /auth/dev-session issues a JWT for localdev@codearena.local (./run.sh sets this by default).
# CODEARENA_DEV_AUTO_LOGIN=1
