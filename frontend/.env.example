# Frontend Environment Variables
# Copy this to .env.local and fill in values as needed

# For local development, most features work without these
# The frontend uses http://localhost:3001 when NODE_ENV is not production, or when
# you open the app at localhost / 127.0.0.1 (even with `next start`).
# Set both public origins explicitly in each deployment environment.

# Google OAuth (optional - only needed for Google Sign-In)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# GitHub OAuth (optional - only needed for GitHub Sign-In)
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id

# Sentry Error Tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Backend URL (optional - defaults to localhost:3001 in dev).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Frontend URL (optional - defaults to localhost:3000 in dev).
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Local-only: auto dev guest login (requires backend CODEARENA_DEV_AUTO_LOGIN=1). ./run.sh sets both by default.
# NEXT_PUBLIC_CODEARENA_DEV_AUTO_LOGIN=1
# Optional second guest user for two-browser testing (use with a second dev server on another port).
# NEXT_PUBLIC_CODEARENA_DEV_LOGIN_SLOT=2
